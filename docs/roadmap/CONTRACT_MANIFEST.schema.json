{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckLab changed-route contract entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "path",
    "contract_version",
    "source_module",
    "account_scope",
    "authentication",
    "authorization",
    "request_schema",
    "response_schemas_by_status",
    "unknown_field_policy",
    "error_codes",
    "pause_semantics",
    "persistence_store",
    "idempotency_identity",
    "payload_hash_rule",
    "settings_revision_rule",
    "supported_clients",
    "legacy_fallback",
    "fixture_ids"
  ],
  "properties": {
    "method": {
      "enum": [
        "GET",
        "POST"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^/api/"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "source_module": {
      "type": "string",
      "minLength": 1
    },
    "account_scope": {
      "type": "string",
      "minLength": 1
    },
    "authentication": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "type": "string",
      "minLength": 1
    },
    "request_schema": {
      "type": "object",
      "minProperties": 1
    },
    "response_schemas_by_status": {
      "type": "object",
      "minProperties": 1
    },
    "unknown_field_policy": {
      "type": "string",
      "minLength": 1
    },
    "error_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pause_semantics": {
      "type": "string",
      "minLength": 1
    },
    "persistence_store": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_identity": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash_rule": {
      "type": "string",
      "minLength": 1
    },
    "settings_revision_rule": {
      "type": "string",
      "minLength": 1
    },
    "supported_clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legacy_fallback": {
      "type": "string",
      "minLength": 1
    },
    "fixture_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$comment": "A route entry must be complete and fixture-reviewed before its implementation; this schema is a planning deliverable, not an implemented API contract."
}