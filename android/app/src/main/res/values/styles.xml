<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0b1014</item>
        <item name="android:navigationBarColor">#0b1014</item>
        <item name="android:colorAccent">#d5f584</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0b1014</item>
    </style>
    <style name="NativePaper" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#007D76</item>
        <item name="android:windowBackground">#F4F5F0</item><item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F5F0</item><item name="android:navigationBarColor">#FFFFFF</item>
    </style>
    <style name="NativeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#76D8C7</item>
        <item name="android:windowBackground">#070D1B</item><item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#070D1B</item><item name="android:navigationBarColor">#0B1425</item>
    </style>
</resources>
